{
  "name": "ai-chat-interface",
  "version": "0.1.1",
  "private": true,
  "main": "electron.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test tests/*.test.mjs",
    "eval": "node --env-file=.env.local scripts/eval-live.mjs",
    "metrics": "node scripts/metrics-report.mjs",
    "electron": "electron .",
    "electron:dist": "next build && electron-builder"
  },
  "dependencies": {
    "mammoth": "1.13.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "unpdf": "1.8.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^33.0.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.nimbus.aichat",
    "productName": "Nimbus",
    "files": ["electron.js", "package.json"],
    "afterPack": "scripts/afterPack.js",
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone",
        "filter": ["**/*", "!node_modules"]
      },
      {
        "from": ".next/static",
        "to": "standalone/.next/static"
      },
      {
        "from": "public",
        "to": "standalone/public"
      },
      {
        "from": ".env.local",
        "to": "standalone/.env.local"
      }
    ]
  }
}
